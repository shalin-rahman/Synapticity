import hashlib
import json
import os

def get_project_hash(project_path):
    """Creates a unique hash based on all file contents in the project folder."""
    hasher = hashlib.md5()
    for root, _, files in os.walk(project_path):
        for file in sorted(files):
            if file.endswith(('.md', '.pdf', '.txt')):
                with open(os.path.join(root, file), "rb") as f:
                    hasher.update(f.read())
    return hasher.hexdigest()

def get_cached_specs(project_name, current_hash):
    cache_file = f"projects/{project_name}/cache_specs.json"
    if os.path.exists(cache_file):
        with open(cache_file, "r") as f:
            cache_data = json.load(f)
            if cache_data.get("hash") == current_hash:
                print(f"♻️ Using cached specs for {project_name}...")
                return cache_data.get("specs")
    return None

def save_specs_to_cache(project_name, current_hash, specs):
    cache_file = f"projects/{project_name}/cache_specs.json"
    with open(cache_file, "w") as f:
        json.dump({"hash": current_hash, "specs": specs}, f)
