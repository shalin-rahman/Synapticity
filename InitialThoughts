    print("🧪 Tester is verifying...")
    test_results = call_local_llm("tester.md", code)
    
    print("✅ Final Review by Orchestrator...")
    final_report = call_gemini("orchestrator.md", f"Specs: {specs}\nCode: {code}\nTests: {test_results}")
    
