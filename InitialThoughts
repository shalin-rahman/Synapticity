import os
import requests
from google import genai

# --- CONFIGURATION ---
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"
LOCAL_LLM_URL = "http://localhost:11434/api/generate"
LOCAL_MODEL = "qwen2.5-coder:7b" # Or deepseek-r1

client = genai.Client(api_key=GEMINI_API_KEY)

def call_gemini(persona_file, user_input):
    with open(f".claude/agents/{persona_file}", "r") as f:
        system_prompt = f.read()
    
    response = client.models.generate_content(
        model="gemini-3-flash",
        contents=f"{system_prompt}\n\nUser Request: {user_input}"
    )
    return response.text

def call_local_llm(persona_file, context_input):
    with open(f".claude/agents/{persona_file}", "r") as f:
        system_prompt = f.read()
    
    payload = {
        "model": LOCAL_MODEL,
        "prompt": f"{system_prompt}\n\nContext: {context_input}",
        "stream": False
    }
    response = requests.post(LOCAL_LLM_URL, json=payload)
    return response.json()['response']

# --- AGENT ORCHESTRATION LOOP ---
def run_dev_team(user_goal):
    print("🚀 PM is defining requirements...")
    specs = call_gemini("product-manager.md", user_goal)
    
    print("💻 SWE is writing code (Local LLM)...")
